<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Commands - WelcomeBot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-animation"></div>
  <div class="grid-overlay"></div>
  <div class="particles"></div>

  <nav class="navbar">
    <a href="/" class="nav-brand">
      <div class="logo">👋</div>
      WelcomeBot
    </a>
    <div class="nav-links">
      <a href="/" class="nav-link">Home</a>
      <a href="/commands" class="nav-link active">Commands</a>
      <a href="/status" class="nav-link">Status</a>
      <a href="/dashboard" class="nav-link">Dashboard</a>
    </div>
    <div class="nav-auth">
      <% if (user) { %>
        <a href="/dashboard" class="btn-discord btn-discord-outline">Dashboard</a>
      <% } else { %>
        <a href="/auth/login" class="btn-discord">Login with Discord</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <div class="section-header" style="padding-top: 40px;">
      <h1 class="section-title" style="font-size: 2.8rem;">All Commands</h1>
      <p class="section-desc"><%= commands.length %> commands available. Use them all in your server!</p>
    </div>

    <div class="commands-grid">
      <% const categories = {
        'Welcome System': ['setup-welcome', 'test-welcome', 'disable-welcome', 'setup-goodbye', 'disable-goodbye', 'setup-autorole', 'disable-autorole', 'setup-boost', 'setup-logs', 'welcome-preview', 'welcome-logs', 'pause-welcome', 'resume-welcome', 'clean-welcomes'],
        'Moderation': ['kick', 'ban', 'unban', 'mute', 'unmute', 'warn', 'warnings', 'clearwarnings', 'purge', 'lock', 'unlock', 'slowmode', 'timeout', 'untimeout'],
        'Fun': ['8ball', 'coinflip', 'dice', 'rps', 'poll', 'giveaway', 'joke', 'random', 'calc', 'remind'],
        'Utility': ['help', 'ping', 'invite', 'serverinfo', 'userinfo', 'botinfo', 'avatar', 'banner', 'roleinfo', 'channelinfo', 'stats', 'top-commands', 'widget', 'set-prefix', 'nick', 'role-add', 'role-remove'],
        'Leveling': ['level', 'leaderboard'],
        'Management': ['broadcast', 'migrate-server', 'join-all', 'mass-dm', 'setup-reaction-role', 'setup-verification', 'verify-stats', 'msg', 'say']
      }; %>
      <% const catColors = {
        'Welcome System': 'cat-welcome',
        'Moderation': 'cat-mod',
        'Fun': 'cat-fun',
        'Utility': 'cat-util',
        'Leveling': 'cat-util',
        'Management': 'cat-mod'
      }; %>
      <% for (const [category, cmds] of Object.entries(categories)) { %>
        <% cmds.forEach(cmdName => { %>
          <% const cmd = commands.find(c => c.name === cmdName); %>
          <% if (cmd) { %>
            <div class="command-card" data-animate>
              <div class="command-name">/<%= cmd.name %></div>
              <div class="command-desc"><%= cmd.description %></div>
              <span class="command-category <%= catColors[category] || 'cat-util' %>"><%= category %></span>
            </div>
          <% } %>
        <% }); %>
      <% } %>
    </div>
  </div>

  <footer class="footer">
    <p>WelcomeBot &copy; 2026 | Built with love for the Discord community</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
