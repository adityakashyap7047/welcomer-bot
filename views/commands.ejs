<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Commands - WelcomeBot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-animation"></div>
  <div class="grid-overlay"></div>
  <div class="particles"></div>

  <nav class="navbar">
    <a href="/" class="nav-brand">
      <div class="logo">👋</div>
      WelcomeBot
    </a>
    <div class="nav-links">
      <a href="/" class="nav-link">Home</a>
      <a href="/commands" class="nav-link active">Commands</a>
      <a href="/status" class="nav-link">Status</a>
      <a href="/dashboard" class="nav-link">Dashboard</a>
    </div>
    <div class="nav-auth">
      <% if (user) { %>
        <a href="/dashboard" class="btn-discord btn-discord-outline">Dashboard</a>
      <% } else { %>
        <a href="/auth/login" class="btn-discord">Login with Discord</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <div class="section-header" style="padding-top: 40px;">
      <h1 class="section-title" style="font-size: 2.8rem;">All Commands</h1>
      <p class="section-desc">40+ commands across 5 categories. Use them all in your server!</p>
    </div>

    <div class="commands-grid">
      <!-- Welcome System -->
      <div class="command-card" data-animate>
        <div class="command-name">/welcome-channel</div>
        <div class="command-desc">Set the channel for welcome messages</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/welcome-message</div>
        <div class="command-desc">Customize the welcome message text</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/welcome-toggle</div>
        <div class="command-desc">Enable or disable the welcome system</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/welcome-preview</div>
        <div class="command-desc">Preview how your welcome message looks</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/welcome-color</div>
        <div class="command-desc">Set the embed color for welcome messages</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/welcome-title</div>
        <div class="command-desc">Set the embed title for welcome messages</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/goodbye-channel</div>
        <div class="command-desc">Set the channel for goodbye messages</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/goodbye-message</div>
        <div class="command-desc">Customize the goodbye message text</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/goodbye-toggle</div>
        <div class="command-desc">Enable or disable goodbye messages</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/autorole</div>
        <div class="command-desc">Auto-assign roles to new members</div>
        <span class="command-category cat-welcome">Welcome</span>
      </div>

      <!-- Moderation -->
      <div class="command-card" data-animate>
        <div class="command-name">/kick</div>
        <div class="command-desc">Kick a member from the server</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/ban</div>
        <div class="command-desc">Ban a member with optional message purge</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/unban</div>
        <div class="command-desc">Unban a user by their ID</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/mute</div>
        <div class="command-desc">Timeout a member for a set duration</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/unmute</div>
        <div class="command-desc">Remove timeout from a member</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/purge</div>
        <div class="command-desc">Bulk delete messages from a channel</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/lock</div>
        <div class="command-desc">Lock a channel to prevent messages</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/unlock</div>
        <div class="command-desc">Unlock a previously locked channel</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/slowmode</div>
        <div class="command-desc">Set slowmode delay for a channel</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/warn</div>
        <div class="command-desc">Warn a member for rule violations</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/warnings</div>
        <div class="command-desc">View all warnings for a user</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/clear-warnings</div>
        <div class="command-desc">Clear all warnings for a user</div>
        <span class="command-category cat-mod">Moderation</span>
      </div>

      <!-- Utility -->
      <div class="command-card" data-animate>
        <div class="command-name">/ping</div>
        <div class="command-desc">Check bot and API latency</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/server-info</div>
        <div class="command-desc">Get detailed server information</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/user-info</div>
        <div class="command-desc">Get detailed user information</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/avatar</div>
        <div class="command-desc">Get a user's avatar in full resolution</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/banner</div>
        <div class="command-desc">Get a user's profile banner</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/role-info</div>
        <div class="command-desc">Get information about a role</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/member-count</div>
        <div class="command-desc">Get detailed member statistics</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/invite</div>
        <div class="command-desc">Get the bot invite link</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/calc</div>
        <div class="command-desc">Evaluate a math expression</div>
        <span class="command-category cat-util">Utility</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/remind</div>
        <div class="command-desc">Set a timed reminder</div>
        <span class="command-category cat-util">Utility</span>
      </div>

      <!-- Fun -->
      <div class="command-card" data-animate>
        <div class="command-name">/8ball</div>
        <div class="command-desc">Ask the magic 8-ball a question</div>
        <span class="command-category cat-fun">Fun</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/coinflip</div>
        <div class="command-desc">Flip a coin - heads or tails?</div>
        <span class="command-category cat-fun">Fun</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/dice</div>
        <div class="command-desc">Roll a dice with custom sides</div>
        <span class="command-category cat-fun">Fun</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/rps</div>
        <div class="command-desc">Play rock paper scissors</div>
        <span class="command-category cat-fun">Fun</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/poll</div>
        <div class="command-desc">Create an interactive poll</div>
        <span class="command-category cat-fun">Fun</span>
      </div>
      <div class="command-card" data-animate>
        <div class="command-name">/giveaway</div>
        <div class="command-desc">Start a timed giveaway</div>
        <span class="command-category cat-fun">Fun</span>
      </div>
    </div>
  </div>

  <footer class="footer">
    <p>WelcomeBot &copy; 2026 | Built with love for the Discord community</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
