<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - WelcomeBot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-animation"></div>
  <div class="grid-overlay"></div>
  <div class="particles"></div>

  <nav class="navbar">
    <a href="/" class="nav-brand">
      <div class="logo">👋</div>
      WelcomeBot
    </a>
    <div class="nav-links">
      <a href="/" class="nav-link">Home</a>
      <a href="/commands" class="nav-link">Commands</a>
      <a href="/status" class="nav-link">Status</a>
      <a href="/dashboard" class="nav-link active">Dashboard</a>
    </div>
    <div class="nav-auth">
      <% if (user) { %>
        <a href="/auth/logout" class="btn-discord btn-discord-outline">Logout</a>
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" class="user-avatar" alt="Avatar">
      <% } else { %>
        <a href="/auth/login" class="btn-discord">Login with Discord</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <div class="dashboard-header" style="padding-top: 20px;">
      <div>
        <h1 class="dashboard-title">Server Dashboard</h1>
        <p style="color: var(--text-secondary); margin-top: 4px;">Select a server to configure</p>
      </div>
      <div class="live-counter">
        <div class="live-dot"></div>
        <%= guilds.length %> server<%= guilds.length !== 1 ? 's' : '' %> manageable
      </div>
    </div>

    <% if (guilds.length === 0) { %>
      <div class="settings-section" style="text-align: center; padding: 60px 32px;">
        <div style="font-size: 3rem; margin-bottom: 16px;">🔍</div>
        <h3 style="margin-bottom: 12px;">No servers found</h3>
        <p style="color: var(--text-secondary); margin-bottom: 24px;">
          You need the "Manage Server" permission to configure WelcomeBot.
        </p>
        <a href="/auth/login" class="btn-primary">Re-authenticate</a>
      </div>
    <% } else { %>
      <div class="guild-grid">
        <% guilds.forEach((guild, i) => { %>
          <a href="/dashboard/<%= guild.id %>" class="guild-card" style="animation-delay: <%= i * 0.1 %>s;">
            <% if (guild.icon) { %>
              <img src="<%= guild.icon %>" class="guild-icon" alt="<%= guild.name %>">
            <% } else { %>
              <div class="guild-icon" style="background: var(--gradient-1); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 700;">
                <%= guild.name.charAt(0) %>
              </div>
            <% } %>
            <div class="guild-info">
              <div class="guild-name"><%= guild.name %></div>
              <div class="guild-members">👥 <%= guild.memberCount %> members</div>
            </div>
            <% if (guild.config && guild.config.welcomeEnabled) { %>
              <span class="guild-status status-active">Active</span>
            <% } else { %>
              <span class="guild-status status-inactive">Inactive</span>
            <% } %>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>

  <footer class="footer">
    <p>WelcomeBot &copy; 2026 | Built with love for the Discord community</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
