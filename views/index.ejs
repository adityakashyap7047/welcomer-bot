<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WelcomeBot - Discord Welcomer Bot</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>👋</text></svg>">
</head>
<body>
  <div class="bg-animation"></div>
  <div class="grid-overlay"></div>
  <div class="particles"></div>

  <nav class="navbar">
    <a href="/" class="nav-brand">
      <div class="logo">👋</div>
      WelcomeBot
    </a>
    <div class="nav-links">
      <a href="/" class="nav-link active">Home</a>
      <a href="/commands" class="nav-link">Commands</a>
      <a href="/status" class="nav-link">Status</a>
      <a href="/dashboard" class="nav-link">Dashboard</a>
    </div>
    <div class="nav-auth">
      <div class="live-counter">
        <div class="live-dot"></div>
        <span data-stat="guilds"><%= stats.guilds %></span> servers
      </div>
      <a href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands" class="btn-discord" target="_blank" style="background:#57F287;">
        Add to Server
      </a>
      <% if (user) { %>
        <a href="/dashboard" class="btn-discord btn-discord-outline">Dashboard</a>
        <a href="/auth/logout" class="btn-discord">Logout</a>
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" class="user-avatar" alt="Avatar">
      <% } else { %>
        <a href="/auth/login" class="btn-discord">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.36-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02c-2.72 4.07-3.47 8.03-3.1 11.95c0 .02.01.04.03.05c1.8 1.32 3.53 2.12 5.24 2.65c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.08-.04-.09c-.57-.22-1.11-.48-1.64-.78c-.04-.02-.04-.08-.01-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.16 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09-.01.11c-.52.31-1.07.56-1.64.78c-.04.01-.05.06-.04.09c.32.61.68 1.19 1.07 1.74c.03.01.06.02.09.01c1.72-.53 3.45-1.33 5.25-2.65c.02-.01.03-.03.03-.05c.44-4.53-.73-8.46-3.1-11.95c-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.83 2.12-1.89 2.12z"/></svg>
          Login with Discord
        </a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <section class="hero">
      <h1 class="hero-title">
        The Ultimate<br>
        <span class="gradient">Discord Welcomer</span>
      </h1>
      <p class="hero-subtitle">
        Beautiful welcome cards, powerful moderation, and a stunning 3D dashboard.
        Make your server feel like home.
      </p>
      <div class="hero-buttons">
        <a href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands" class="btn-primary" target="_blank">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.36-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02c-2.72 4.07-3.47 8.03-3.1 11.95c0 .02.01.04.03.05c1.8 1.32 3.53 2.12 5.24 2.65c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.08-.04-.09c-.57-.22-1.11-.48-1.64-.78c-.04-.02-.04-.08-.01-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.16 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09-.01.11c-.52.31-1.07.56-1.64.78c-.04.01-.05.06-.04.09c.32.61.68 1.19 1.07 1.74c.03.01.06.02.09.01c1.72-.53 3.45-1.33 5.25-2.65c.02-.01.03-.03.03-.05c.44-4.53-.73-8.46-3.1-11.95c-.01-.01-.02-.02-.04-.02z"/></svg>
          Add to Server
        </a>
        <a href="/auth/login" class="btn-primary">
          Get Started
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/commands" class="btn-secondary">
          View Commands
        </a>
      </div>
    </section>

    <div class="stats-bar">
      <div class="stat-card" data-animate>
        <div class="stat-number" data-stat="guilds"><%= stats.guilds %></div>
        <div class="stat-label">Servers</div>
      </div>
      <div class="stat-card" data-animate>
        <div class="stat-number" data-stat="users"><%= stats.users %></div>
        <div class="stat-label">Users Reached</div>
      </div>
      <div class="stat-card" data-animate>
        <div class="stat-number" data-stat-uptime>...</div>
        <div class="stat-label">Uptime</div>
      </div>
      <div class="stat-card" data-animate>
        <div class="stat-number">24/7</div>
        <div class="stat-label">Online</div>
      </div>
    </div>

    <div class="section-header" data-animate>
      <h2 class="section-title">Why Choose WelcomeBot?</h2>
      <p class="section-desc">Everything you need to make your Discord server amazing</p>
    </div>

    <div class="card-grid">
      <div class="card" data-animate>
        <div class="card-icon">🎨</div>
        <h3 class="card-title">Custom Welcome Cards</h3>
        <p class="card-desc">Beautiful auto-generated welcome images with your server branding. Fully customizable colors, messages, and styles.</p>
      </div>
      <div class="card" data-animate>
        <div class="card-icon">🛡️</div>
        <h3 class="card-title">Powerful Moderation</h3>
        <p class="card-desc">Kick, ban, mute, warn, and manage your server with ease. Full moderation toolkit with audit logs.</p>
      </div>
      <div class="card" data-animate>
        <div class="card-icon">⚡</div>
        <h3 class="card-title">Auto Roles</h3>
        <p class="card-desc">Automatically assign roles to new members. Set it once and forget it. Zero configuration needed.</p>
      </div>
      <div class="card" data-animate>
        <div class="card-icon">📊</div>
        <h3 class="card-title">Live Dashboard</h3>
        <p class="card-desc">Stunning 3D animated dashboard. Configure everything with a beautiful, intuitive interface.</p>
      </div>
      <div class="card" data-animate>
        <div class="card-icon">🎉</div>
        <h3 class="card-title">Fun Commands</h3>
        <p class="card-desc">Giveaways, polls, games, and more. Keep your community engaged and entertained 24/7.</p>
      </div>
      <div class="card" data-animate>
        <div class="card-icon">🚀</div>
        <h3 class="card-title">Lightning Fast</h3>
        <p class="card-desc">Optimized performance with instant response times. Your members won't wait a second.</p>
      </div>
    </div>
  </div>

  <footer class="footer">
    <p>WelcomeBot &copy; 2026 | Built with love for the Discord community</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
